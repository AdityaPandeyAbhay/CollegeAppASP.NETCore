/* =====================================================
   ATTENDANCE REGISTER & PROGRESSION MATRIX STYLES
   (Executive Excel Spreadsheet Matrix Layout)
   ===================================================== */

.attendance-register-page {
  width: 100%;
  min-height: 100vh;
  padding: 125px 24px 40px;
  background: #f8fafc;
  box-sizing: border-box;
}

.attendance-register-container {
  max-width: 100%;
  margin: 0 auto;
}

/* =====================================================
   HEADER BAR
   ===================================================== */
.register-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 20px;
  background: #ffffff;
  padding: 20px 24px;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
}

.header-titles h1 {
  margin: 0 0 4px 0;
  font-size: 24px;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.3px;
}

.subtitle {
  margin: 0;
  font-size: 13.5px;
  color: #64748b;
  font-weight: 500;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.btn-excel-export {
  padding: 9px 16px;
  background: #059669;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-weight: 700;
  font-size: 13.5px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25);
}

.btn-excel-export:hover {
  background: #047857;
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(5, 150, 105, 0.35);
}

.btn-take-att {
  padding: 9px 16px;
  background: #2563eb;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-weight: 700;
  font-size: 13.5px;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
}

.btn-take-att:hover {
  background: #1d4ed8;
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.35);
}

.btn-print {
  padding: 9px 14px;
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 8px;
  color: #334155;
  font-weight: 700;
  font-size: 13.5px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-print:hover {
  background: #f1f5f9;
  border-color: #94a3b8;
}

/* Toast */
.register-toast {
  position: fixed;
  top: 100px;
  right: 30px;
  z-index: 99999;
  background: #059669;
  color: #ffffff;
  padding: 12px 22px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 14px;
  box-shadow: 0 6px 20px rgba(5, 150, 105, 0.3);
  animation: slideInToast 0.3s ease;
}

@keyframes slideInToast {
  from {
    transform: translateY(-20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* =====================================================
   FILTER CONTROLS CARD
   ===================================================== */
.register-controls-card {
  background: #ffffff;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  padding: 18px 22px;
  margin-bottom: 20px;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
}

.filter-grid-layout {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14px;
}

.filter-field-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.filter-field-item label {
  font-size: 11.5px;
  font-weight: 700;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.filter-field-item select {
  width: 100%;
  padding: 9px 12px;
  border: 1.5px solid #cbd5e1;
  border-radius: 8px;
  font-size: 13.5px;
  color: #0f172a;
  background: #ffffff;
  font-weight: 600;
  outline: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.filter-field-item select:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.filter-field-item select:disabled {
  background: #f1f5f9;
  color: #94a3b8;
  cursor: not-allowed;
}

/* =====================================================
   SEARCH & SUMMARY STRIP
   ===================================================== */
.register-filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.student-filter-input {
  flex: 1;
  min-width: 280px;
  max-width: 480px;
  padding: 10px 14px;
  border: 1.5px solid #cbd5e1;
  border-radius: 8px;
  font-size: 13.5px;
  outline: none;
  transition: all 0.2s ease;
  background: #ffffff;
}

.student-filter-input:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.class-indicator-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 13px;
  color: #334155;
  font-weight: 600;
}

.register-error-banner {
  padding: 12px 16px;
  margin-bottom: 16px;
  background: #fee2e2;
  color: #991b1b;
  border: 1px solid #fecaca;
  border-radius: 8px;
  font-size: 13.5px;
  font-weight: 600;
}

/* Card States */
.register-card.loading,
.register-card.empty {
  background: #ffffff;
  padding: 50px 20px;
  text-align: center;
  border-radius: 12px;
  border: 1.5px dashed #cbd5e1;
  color: #64748b;
  font-size: 15px;
  font-weight: 600;
}

.spinner {
  width: 36px;
  height: 36px;
  border: 3.5px solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 12px;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* =====================================================
   EXCEL TABLE CONTAINER & SPREADSHEET MATRIX (PROTOTYPE ALIGNED)
   ===================================================== */
.excel-table-container {
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
  overflow: hidden;
  margin-bottom: 24px;
}

/* Top Legend Strip matching web_ui_prototype.html */
.table-top-legend-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #f1f5f9;
  background: rgba(248, 250, 252, 0.6);
  flex-wrap: wrap;
  gap: 12px;
}

.legend-title-group .legend-sheet-title {
  margin: 0;
  font-size: 16px;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.2px;
}

.legend-title-group .legend-sheet-subtitle {
  margin: 3px 0 0 0;
  font-size: 12px;
  color: #64748b;
  font-weight: 500;
}

.legend-badges-group {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.legend-badge-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: #334155;
}

.legend-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  display: inline-block;
}

.legend-dot.bg-p {
  background-color: #10b981;
}

.legend-dot.bg-a {
  background-color: #f43f5e;
}

.legend-dot.bg-hd {
  background-color: #facc15;
}

.legend-dot.bg-l {
  background-color: #3b82f6;
}

.legend-dot.bg-wo {
  background-color: #94a3b8;
}

.legend-dot.bg-ex {
  background-color: #a855f7;
}

/* Horizontal Scroll Wrapper */
.excel-table-scroll-wrapper {
  overflow-x: auto;
  max-width: 100%;
  max-height: 72vh;
  position: relative;
  background: #ffffff;
}

/* Modern Sleek Scrollbars */
.excel-table-scroll-wrapper::-webkit-scrollbar {
  height: 10px;
  width: 10px;
}

.excel-table-scroll-wrapper::-webkit-scrollbar-track {
  background: #f1f5f9;
}

.excel-table-scroll-wrapper::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 6px;
  border: 2px solid #f1f5f9;
}

.excel-table-scroll-wrapper::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

.excel-attendance-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 12.5px;
  text-align: center;
  white-space: nowrap;
}

/* Cells & Gridlines */
.excel-attendance-table th,
.excel-attendance-table td {
  border-right: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;
  padding: 6px 4px;
  box-sizing: border-box;
  vertical-align: middle;
}

/* Excel Main Header Row */
.excel-header-row th {
  position: sticky;
  top: 0;
  background: #f8fafc;
  color: #334155;
  font-weight: 700;
  font-size: 12px;
  z-index: 20;
  padding: 8px 4px;
  border-right: 1px solid #e2e8f0;
  border-bottom: 2px solid #cbd5e1;
}

/* =====================================================
   FROZEN / STICKY COLUMNS ON LEFT (#, Roll, Adm, Name)
   ===================================================== */
.excel-attendance-table th.sticky-col,
.excel-attendance-table td.sticky-col {
  position: sticky;
  background: #ffffff;
  z-index: 10;
}

.excel-header-row th.sticky-col {
  background: #f1f5f9 !important;
  color: #0f172a !important;
  font-weight: 800;
  z-index: 30;
}

.col-index {
  left: 0;
  width: 44px;
  min-width: 44px;
  max-width: 44px;
  text-align: center;
  font-weight: 700;
  color: #64748b;
}

.col-roll {
  left: 44px;
  width: 66px;
  min-width: 66px;
  max-width: 66px;
  text-align: center;
}

.col-adm {
  left: 110px;
  width: 96px;
  min-width: 96px;
  max-width: 96px;
  text-align: center;
}

.col-name {
  left: 206px;
  min-width: 190px;
  max-width: 220px;
  text-align: left !important;
  padding-left: 12px !important;
  padding-right: 10px !important;
  border-right: 2px solid #cbd5e1 !important;
  box-shadow: 4px 0 8px -2px rgba(15, 23, 42, 0.07);
}

.roll-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 6px;
  background: #f1f5f9;
  border-radius: 6px;
  font-weight: 800;
  color: #0f172a;
  font-size: 12.5px;
  border: 1px solid #e2e8f0;
}

.adm-code {
  font-size: 11.5px;
  font-weight: 700;
  color: #2563eb;
  letter-spacing: 0.2px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.name-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.student-name-bold {
  font-weight: 700;
  color: #0f172a;
  font-size: 13px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-sub-father {
  font-size: 10.5px;
  color: #64748b;
  font-weight: 500;
}

/* =====================================================
   DAY COLUMN HEADERS (1..31)
   ===================================================== */
.day-col-header {
  width: 38px;
  min-width: 38px;
  max-width: 38px;
  padding: 6px 2px !important;
}

.day-num-text {
  display: block;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.1;
  color: #1e293b;
}

.day-weekday-text {
  display: block;
  font-size: 9.5px;
  color: #94a3b8;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.2px;
}

.day-col-header.sunday {
  background: #fff1f2 !important;
}

.day-col-header.sunday .day-num-text {
  color: #991b1b !important;
}

.day-col-header.sunday .day-weekday-text {
  color: #f87171 !important;
}

.day-col-header.holiday {
  background: #fdf2f8 !important;
}

.day-col-header.holiday .day-num-text {
  color: #9d174d !important;
}

.day-col-header.holiday .day-weekday-text {
  color: #f472b6 !important;
}

.day-col-header.exam {
  background: #faf5ff !important;
}

.day-col-header.exam .day-num-text {
  color: #6b21a8 !important;
}

.day-col-header.exam .day-weekday-text {
  color: #c084fc !important;
}

.tag-holiday-pill {
  display: inline-block;
  font-size: 8px;
  font-weight: 800;
  background: #fce7f3;
  color: #be123c;
  padding: 0 3px;
  border-radius: 3px;
  margin-top: 1px;
}

.tag-exam-pill {
  display: inline-block;
  font-size: 8px;
  font-weight: 800;
  background: #f3e8ff;
  color: #7e22ce;
  padding: 0 3px;
  border-radius: 3px;
  margin-top: 1px;
}

/* =====================================================
   STUDENT ROWS & ZEBRA HOVER STATES
   ===================================================== */
.excel-student-row {
  transition: background-color 0.15s ease;
}

.excel-student-row:nth-child(even) {
  background: #ffffff;
}

.excel-student-row:nth-child(even) td.sticky-col {
  background: #ffffff;
}

.excel-student-row:nth-child(odd) {
  background: #fbfcfe;
}

.excel-student-row:nth-child(odd) td.sticky-col {
  background: #fbfcfe;
}

.excel-student-row:hover {
  background: #f1f5f9 !important;
}

.excel-student-row:hover td.sticky-col {
  background: #f1f5f9 !important;
}

/* =====================================================
   DAY ATTENDANCE CELLS & PROTOTYPE STATUS BADGES
   ===================================================== */
.day-cell {
  padding: 5px 2px !important;
  text-align: center;
}

.day-cell.cell-holiday {
  background: rgba(243, 244, 246, 0.4);
}

.day-cell.cell-exam {
  background: rgba(250, 245, 255, 0.4);
}

.excel-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  height: 22px;
  padding: 0 5px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 800;
  box-sizing: border-box;
}

/* Present (P) - Prototype Emerald */
.excel-status-badge.p {
  background-color: #DEF7EC;
  color: #03543F;
  border: 1px solid #31C48D;
}

/* Absent (A) - Prototype Rose */
.excel-status-badge.a {
  background-color: #FDE8E8;
  color: #9B1C1C;
  border: 1px solid #F98080;
}

/* Half Day (HD) - Prototype Yellow/Amber */
.excel-status-badge.hd {
  background-color: #FEF08A;
  color: #854D0E;
  border: 1px solid #FACC15;
  font-size: 9.5px;
}

/* Leave (L) - Prototype Blue */
.excel-status-badge.l {
  background-color: #E1EFFE;
  color: #1E429F;
  border: 1px solid #76A9FA;
}

/* Week-Off / Holiday (WO / H) - Prototype Slate */
.excel-status-badge.h {
  background-color: #F3F4F6;
  color: #6B7280;
  border: 1px solid #D1D5DB;
  font-size: 9.5px;
}

/* Exam Present (EX-P) */
.excel-status-badge.ex-p {
  background-color: #FAF5FF;
  color: #6B21A8;
  border: 1px solid #D8B4FE;
  font-size: 9px;
  min-width: 28px;
}

/* Exam Absent (EX-A) */
.excel-status-badge.ex-a {
  background-color: #FDF2F8;
  color: #9D174D;
  border: 1px solid #F472B6;
  font-size: 9px;
  min-width: 28px;
}

.excel-empty-dash {
  color: #cbd5e1;
  font-weight: 700;
  font-size: 13px;
}

/* =====================================================
   SUMMARY COLUMNS ON RIGHT (TINTED HEADERS & CELLS)
   ===================================================== */
.summary-col-header {
  font-weight: 800 !important;
  font-size: 11.5px !important;
  text-align: center;
  min-width: 90px;
  padding: 8px 6px !important;
}

.summary-col-header.col-month-p {
  background: #def7ec !important;
  color: #03543f !important;
  border-left: 1.5px solid #cbd5e1 !important;
  border-right: 1px solid #cbd5e1 !important;
}

.summary-col-header.col-month-a {
  background: #fde8e8 !important;
  color: #9b1c1c !important;
  border-right: 1px solid #cbd5e1 !important;
}

.summary-col-header.col-month-l {
  background: #e1effe !important;
  color: #1e429f !important;
  border-right: 1px solid #cbd5e1 !important;
}

.summary-col-header.col-month-run {
  background: #eff6ff !important;
  color: #1e40af !important;
  border-right: 1.5px solid #cbd5e1 !important;
}

.summary-col-header.col-hy-ratio {
  background: #f8fafc !important;
  color: #1e293b !important;
  border-right: 1px solid #cbd5e1 !important;
}

.summary-col-header.col-ann-ratio {
  background: #f8fafc !important;
  color: #1e293b !important;
}

.summary-col-header .th-sub {
  display: block;
  font-size: 9.5px;
  font-weight: 600;
  opacity: 0.8;
  text-transform: none;
}

.summary-cell {
  text-align: center;
  font-weight: 700;
  font-size: 12.5px;
}

.summary-cell.col-month-p {
  background: rgba(222, 247, 236, 0.25);
  border-left: 1.5px solid #cbd5e1 !important;
}

.summary-cell.col-month-a {
  background: rgba(253, 232, 232, 0.25);
}

.summary-cell.col-month-l {
  background: rgba(225, 239, 254, 0.25);
}

.summary-cell.col-month-run {
  background: rgba(239, 246, 255, 0.5);
  border-right: 1.5px solid #cbd5e1 !important;
}

.month-present-val {
  color: #03543f;
  font-weight: 800;
  font-size: 13px;
}

.month-absent-val {
  color: #64748b;
  font-weight: 600;
}

.month-absent-val.red {
  color: #9b1c1c;
  font-weight: 800;
  font-size: 13px;
}

.month-leave-val {
  color: #1e429f;
  font-weight: 700;
  font-size: 12.5px;
}

.month-run-val {
  color: #1e40af;
  font-weight: 800;
  font-size: 13px;
}

.ratio-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  font-size: 12px;
}

.ratio-box.hy-box strong {
  color: #2563eb;
  font-size: 12.5px;
}

.ratio-box.ann-box strong {
  color: #059669;
  font-size: 12.5px;
}

.ratio-pct-tag {
  font-size: 9.5px;
  color: #475569;
  background: #f1f5f9;
  padding: 1px 5px;
  border-radius: 10px;
  font-weight: 700;
}

/* =====================================================
   DAILY TOTAL FOOTER ROW (tfoot)
   ===================================================== */
.excel-footer-row {
  position: sticky;
  bottom: 0;
  background: #0f172a;
  color: #ffffff;
  font-weight: 800;
  z-index: 25;
}

.excel-footer-row td {
  border-top: 2px solid #38bdf8;
  border-bottom: none;
  padding: 8px 4px;
  border-right: 1px solid #334155;
}

.footer-label-cell {
  left: 0;
  background: #0f172a !important;
  color: #38bdf8 !important;
  font-size: 12px;
  text-align: left !important;
  padding-left: 12px !important;
  border-right: 2px solid #94a3b8 !important;
  box-shadow: 4px 0 10px -2px rgba(15, 23, 42, 0.2);
}

.footer-day-cell {
  text-align: center;
  font-size: 11px;
  background: #0f172a;
}

.footer-day-cell.holiday {
  background: #831843;
}

.footer-day-cell.exam {
  background: #581c87;
}

.ft-holiday-tag {
  color: #fca5a5;
  font-weight: 800;
}

.ft-ratio-text {
  color: #4ade80;
  font-size: 11.5px;
}

.ft-ratio-text strong {
  color: #ffffff;
}

.ft-empty-dash {
  color: #64748b;
}

.footer-summary-cell {
  text-align: center;
  font-size: 12px;
  color: #ffffff;
  background: #1e293b;
}

.footer-summary-cell.col-month-p strong {
  color: #4ade80;
  font-size: 13.5px;
}

.footer-summary-cell.col-month-a .ft-absent-sum {
  color: #f87171;
  font-size: 13px;
}

.footer-summary-cell.col-month-l .ft-leave-sum {
  color: #93c5fd;
  font-size: 13px;
}

.ft-progression-tag {
  display: inline-block;
  font-size: 9.5px;
  font-weight: 700;
  background: #1e3a8a;
  color: #93c5fd;
  padding: 2px 6px;
  border-radius: 4px;
}

.ft-progression-tag.annual {
  background: #064e3b;
  color: #6ee7b7;
}

/* =====================================================
   BOTTOM ACCORDION & SETTINGS CARD STYLES
   ===================================================== */
.register-bottom-accordion-card {
  margin-top: 24px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
}

.bottom-accordion-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  background: #f8fafc;
  cursor: pointer;
  border-bottom: 1px solid #e2e8f0;
  user-select: none;
  transition: background 0.2s ease;
}

.bottom-accordion-header:hover {
  background: #f1f5f9;
}

.bottom-acc-title {
  display: flex;
  flex-direction: column;
  gap: 3px;
  font-size: 15px;
  font-weight: 700;
  color: #1e293b;
}

.bottom-acc-subtitle {
  font-size: 12.5px;
  font-weight: 500;
  color: #64748b;
}

.btn-toggle-acc {
  background: #ffffff;
  border: 1px solid #cbd5e1;
  padding: 6px 14px;
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 700;
  color: #334155;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-toggle-acc:hover {
  background: #e2e8f0;
  color: #0f172a;
}

.bottom-accordion-content {
  padding: 20px;
  background: #ffffff;
}

.settings-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 20px;
}

.setting-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.setting-box-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-box h4 {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
}

.setting-box p {
  margin: 0;
  font-size: 12.5px;
  color: #64748b;
  line-height: 1.4;
}

.cutoff-status-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 4px 0 8px;
}

.cs-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  font-size: 13px;
  color: #334155;
  gap: 10px;
}

.cs-label-val {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cs-row strong {
  color: #0f172a;
}

.btn-reset-inline {
  padding: 3px 9px;
  background: #fee2e2;
  color: #b91c1c;
  border: 1px solid #fecaca;
  border-radius: 6px;
  font-size: 11.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-reset-inline:hover {
  background: #fecaca;
  color: #991b1b;
}

.btn-reset-all-decls {
  padding: 4px 10px;
  background: #fef2f2;
  color: #dc2626;
  border: 1px solid #fca5a5;
  border-radius: 6px;
  font-size: 11.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-reset-all-decls:hover {
  background: #fee2e2;
}

.setting-actions-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-setting-action {
  padding: 8px 14px;
  background: #2563eb;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s;
  align-self: flex-start;
}

.btn-setting-action:hover {
  background: #1d4ed8;
}

.btn-setting-action.holiday-btn {
  background: #9333ea;
}

.btn-setting-action.holiday-btn:hover {
  background: #7e22ce;
}

.no-decls-text {
  font-size: 13px;
  color: #94a3b8;
  font-style: italic;
  margin-bottom: 8px;
}

.decls-tags-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.decl-tag {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 12.5px;
}

.decl-tag.holiday {
  background: #fdf2f8;
  color: #9d174d;
  border: 1px solid #fbcfe8;
}

.decl-tag.exam {
  background: #faf5ff;
  color: #7e22ce;
  border: 1px solid #e9d5ff;
}

.decl-tag button {
  background: transparent;
  border: none;
  color: #dc2626;
  font-weight: 800;
  cursor: pointer;
  font-size: 14px;
  padding: 0 4px;
}

.decl-tag button:hover {
  color: #991b1b;
}

/* =====================================================
   MODALS
   ===================================================== */
.register-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(4px);
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.register-modal-card {
  background: #ffffff;
  border-radius: 16px;
  width: 100%;
  max-width: 520px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  overflow: hidden;
  animation: modalScaleIn 0.25s ease;
}

@keyframes modalScaleIn {
  from {
    transform: scale(0.95);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
  background: #0f172a;
  color: #ffffff;
}

.modal-header h3 {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
}

.btn-modal-close {
  background: transparent;
  border: none;
  color: #94a3b8;
  font-size: 20px;
  cursor: pointer;
  line-height: 1;
}

.btn-modal-close:hover {
  color: #ffffff;
}

.modal-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.modal-desc {
  margin: 0;
  font-size: 13px;
  color: #64748b;
  line-height: 1.45;
}

.modal-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.modal-field label {
  font-size: 13px;
  font-weight: 700;
  color: #1e293b;
}

.modal-input-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-input-group input {
  flex: 1;
}

.modal-field input,
.modal-field select {
  padding: 10px 12px;
  border: 1.5px solid #cbd5e1;
  border-radius: 8px;
  font-size: 13.5px;
  outline: none;
}

.modal-field input:focus,
.modal-field select:focus {
  border-color: #2563eb;
}

.btn-input-clear {
  padding: 9px 12px;
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  color: #64748b;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
}

.btn-input-clear:hover {
  background: #fee2e2;
  color: #dc2626;
  border-color: #fca5a5;
}

.modal-field small {
  font-size: 11.5px;
  color: #64748b;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding: 16px 24px;
  background: #f8fafc;
  border-top: 1px solid #e2e8f0;
}

.btn-modal-cancel {
  padding: 8px 16px;
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 8px;
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
}

.btn-modal-save {
  padding: 8px 18px;
  background: #2563eb;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
}

.btn-modal-save:hover {
  background: #1d4ed8;
}

/* =====================================================
   RESPONSIVE & PRINT MEDIA
   ===================================================== */
@media (max-width: 1200px) {
  .filter-grid-layout {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .attendance-register-page {
    padding: 125px 12px 30px;
  }

  .register-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .filter-grid-layout {
    grid-template-columns: 1fr;
  }
}

@media print {
  body {
    background: #ffffff !important;
  }

  .attendance-register-page {
    padding: 0 !important;
  }

  .register-header,
  .register-controls-card,
  .register-filter-bar,
  .header-actions,
  .register-bottom-accordion-card {
    display: none !important;
  }

  .excel-table-container {
    border: 1px solid #000000 !important;
    box-shadow: none !important;
  }

  .excel-attendance-table th,
  .excel-attendance-table td {
    border: 1px solid #000000 !important;
    font-size: 8pt !important;
    padding: 2px !important;
  }
}
